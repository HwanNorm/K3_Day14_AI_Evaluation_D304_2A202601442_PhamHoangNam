# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value(s).
# Set LLM_PROVIDER to "openai" or "openrouter" to pick which block below is used.
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter (https://openrouter.ai) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
